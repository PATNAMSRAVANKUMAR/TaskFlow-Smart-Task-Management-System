{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "TaskFlow - Smart Task Management System",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"yellow,cyan\" \"npm run server:dev\" \"npm run client\"",
    "start": "concurrently -n \"server,client\" -c \"yellow,cyan\" \"npm run server\" \"npm run client\"",
    "install-all": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build"
  },
  "keywords": [
    "taskflow",
    "task-manager",
    "mern",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
